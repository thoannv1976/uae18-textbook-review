# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Firebase project (must match the project ID `dggt-9fe0c`)
FIREBASE_PROJECT_ID=dggt-9fe0c

# Firebase client SDK config (NEXT_PUBLIC_*) — copy from Firebase Console -> Project settings -> SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dggt-9fe0c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dggt-9fe0c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dggt-9fe0c.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase App Check site key (reCAPTCHA v3) — wired in client SDK
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Firebase Admin (server-side). Either provide GOOGLE_APPLICATION_CREDENTIALS path
# (recommended on Cloud Run with workload identity) or paste service account JSON below.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional rate-limit overrides (defaults: 3/hour, 10/day per user)
RATE_LIMIT_PER_HOUR=3
RATE_LIMIT_PER_DAY=10
